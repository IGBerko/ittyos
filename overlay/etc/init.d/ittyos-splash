#!/sbin/openrc-run
# ittyOS boot splash (Plymouth), started from OpenRC.
# Never fails the boot: every step is optional and time-limited.

description="ittyOS boot splash (Plymouth)"

depend() {
	need sysfs devfs
	after mdev udev hwdrivers modules
}

start() {
	command -v plymouthd >/dev/null 2>&1 || return 0
	[ -e /etc/ittyos/no-splash ] && return 0
	ebegin "Starting the boot splash"
	mkdir -p /run/plymouth
	# the graphics driver is loaded asynchronously: wait a little for a display device
	i=0
	while [ $i -lt 10 ]; do
		[ -e /dev/fb0 ] || [ -e /dev/dri/card0 ] && break
		sleep 0.5 2>/dev/null || sleep 1
		i=$((i + 1))
	done
	dbg=
	[ -e /etc/ittyos/splash-debug ] && dbg="--debug --debug-file=/var/log/ittyos-plymouth.log"
	# shellcheck disable=SC2086
	plymouthd --mode=boot --pid-file=/run/plymouth/pid --attach-to-session $dbg >/dev/null 2>&1
	timeout 5 plymouth show-splash >/dev/null 2>&1
	eend 0
}

stop() {
	command -v plymouth >/dev/null 2>&1 || return 0
	timeout 5 plymouth quit >/dev/null 2>&1
	return 0
}
