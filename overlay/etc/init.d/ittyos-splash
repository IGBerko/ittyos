#!/sbin/openrc-run
# ittyOS boot splash (Plymouth), started from OpenRC.
# Never fails the boot: every step is optional and time-limited.
# What happened is written to /var/log/ittyos-splash.log and /var/log/ittyos-plymouth.log.

description="ittyOS boot splash (Plymouth)"
SPLASH_LOG=/var/log/ittyos-splash.log

depend() {
	need sysfs devfs
	after mdev udev hwdrivers modules
}

slog() { echo "$(date +%T 2>/dev/null) $*" >> "$SPLASH_LOG"; }

start() {
	: > "$SPLASH_LOG"
	if ! command -v plymouthd >/dev/null 2>&1; then slog "plymouthd not found"; return 0; fi
	if [ -e /etc/ittyos/no-splash ]; then slog "skipped: /etc/ittyos/no-splash"; return 0; fi
	ebegin "Starting the boot splash"
	mkdir -p /run/plymouth

	# Graphics drivers of virtual machines are not always loaded this early: ask for them
	# (a missing module is not an error).
	for m in simpledrm vmwgfx vboxvideo virtio_gpu bochs cirrus; do
		timeout 5 modprobe -q "$m" >/dev/null 2>&1
	done
	# wait for a display device (up to 10 s)
	i=0
	while [ $i -lt 20 ]; do
		{ [ -e /dev/fb0 ] || [ -e /dev/dri/card0 ]; } && break
		sleep 0.5 2>/dev/null || sleep 1
		i=$((i + 1))
	done
	slog "display devices: $(ls /dev/dri/card* /dev/fb* 2>/dev/null | tr '\n' ' ')(waited $i x 0.5s)"
	slog "kernel command line: $(cat /proc/cmdline 2>/dev/null)"

	plymouthd --mode=boot --pid-file=/run/plymouth/pid --attach-to-session \
		--debug --debug-file=/var/log/ittyos-plymouth.log >>"$SPLASH_LOG" 2>&1
	slog "plymouthd exit code $?"
	# the client may come before the daemon listens: wait for it
	i=0
	while [ $i -lt 10 ]; do
		timeout 2 plymouth --ping >/dev/null 2>&1 && break
		sleep 0.3 2>/dev/null || sleep 1
		i=$((i + 1))
	done
	slog "ping tries: $i"
	timeout 5 plymouth show-splash >>"$SPLASH_LOG" 2>&1
	slog "show-splash exit code $?"
	eend 0
}

stop() {
	command -v plymouth >/dev/null 2>&1 || return 0
	timeout 5 plymouth quit >/dev/null 2>&1
	return 0
}
