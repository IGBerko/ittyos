#!/bin/sh
# flowkit - package manager of ittyOS (apk frontend + protection layers: YARA, ClamAV, apk audit)

FK_VERSION="@VERSION@"
case $FK_VERSION in @*) FK_VERSION=dev ;; esac
FK_ARCH="cmp86_64"
FK_MINYEAR=2026
APK="${FLOWKIT_APK:-/sbin/apk}"
CLAMDB="/var/lib/clamav"
BLOCKED="$CLAMDB/.flowkit-blocked"
FRLOG="/var/log/flowkit-av-update.log"
YARA_DIRS="/usr/share/ittyos/yara /etc/ittyos/yara"

if [ -t 1 ]; then
	R=$(printf '\033[0m'); B=$(printf '\033[1m'); CY=$(printf '\033[36m')
	GR=$(printf '\033[32m'); RD=$(printf '\033[31m'); YL=$(printf '\033[33m')
else
	R=; B=; CY=; GR=; RD=; YL=
fi

info() { printf '%s==>%s %s\n' "$CY" "$R" "$*"; }
ok()   { printf '%s ok%s %s\n' "$GR" "$R" "$*"; }
warn() { printf '%s !!%s %s\n' "$YL" "$R" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$RD" "$R" "$*" >&2; exit 1; }

need_root() { [ "$(id -u)" = 0 ] || die "root privileges required (run as root or via sudo)"; }

version() { echo "flowkit $FK_VERSION, $FK_ARCH"; }

usage() {
	cat <<EOF
${B}flowkit $FK_VERSION${R} - package manager of ittyOS

${B}Usage:${R} flowkit <command> [options]

${CY}Packages${R}
  -i, install, add <pkg...>   install packages (virus-checked first)
        --no-scan             install without the virus check
  -r, remove, del <pkg...>    remove packages
  -s, search <query>          search packages
  -l, list [-a]               installed packages (-a: all available)
      info <pkg>              package details
      update                  refresh repository indexes
      upgrade                 upgrade installed packages

${CY}Protection${R}
      scan [path]             scan with YARA and ClamAV (default: system dirs)
      audit                   check installed files against their packages
      av install              install YARA and ClamAV
      av update [--verbose]   download ClamAV databases (--verbose: show raw output)
      av status               state of every protection layer

${CY}Other${R}
  -v, --version               show flowkit version
  -h, --help                  show this help

Any other command is passed to apk unchanged.
EOF
}

# ---- engines ---------------------------------------------------------------

have_av() { command -v clamscan >/dev/null 2>&1; }
have_db() {
	for f in "$CLAMDB"/*.cvd "$CLAMDB"/*.cld; do
		[ -e "$f" ] && return 0
	done
	return 1
}

# list of YARA rule files (space separated)
yara_rules() {
	out=
	for d in $YARA_DIRS; do
		for f in "$d"/*.yar "$d"/*.yara; do
			[ -f "$f" ] && out="$out $f"
		done
	done
	printf '%s' "$out"
}

# YARA is usable when the binary exists and the rules compile
have_yara() {
	command -v yara >/dev/null 2>&1 || return 1
	rules=$(yara_rules)
	[ -n "$rules" ] || return 1
	# shellcheck disable=SC2086
	yara $rules /dev/null >/dev/null 2>&1
}

# scan the given paths with YARA, print "Rule path" lines (rule files themselves are ignored)
run_yara() {
	rules=$(yara_rules)
	for t in "$@"; do
		# shellcheck disable=SC2086
		yara -r $rules "$t" 2>/dev/null
	done | grep -vE ' (/usr/share/ittyos/yara|/etc/ittyos/yara)/'
}

# Downloads packages (with dependencies) to a temp dir and scans them with ClamAV.
scan_packages() {
	if ! have_av; then
		warn "ClamAV not installed (flowkit av install), package check skipped"
		return 0
	fi
	if ! have_db; then
		warn "ClamAV databases not available (flowkit av status), package check skipped"
		return 0
	fi
	tmp=$(mktemp -d /tmp/flowkit.XXXXXX) || return 0
	info "scanning packages for viruses..."
	if ! "$APK" fetch -R -o "$tmp" "$@" >/dev/null 2>&1; then
		rm -rf "$tmp"
		warn "could not download packages for scanning, check skipped"
		return 0
	fi
	clamscan -r --infected --no-summary "$tmp"
	rc=$?
	rm -rf "$tmp"
	case $rc in
		0) ok "no threats found" ;;
		1) die "virus found, installation cancelled" ;;
		*) warn "antivirus failed (code $rc), check skipped" ;;
	esac
	return 0
}

cmd_install() {
	need_root
	scan=1
	cnt=$#; i=0
	while [ "$i" -lt "$cnt" ]; do
		a=$1; shift; i=$((i + 1))
		case $a in
			--no-scan) scan=0 ;;
			*) set -- "$@" "$a" ;;
		esac
	done
	[ $# -gt 0 ] || die "specify a package: flowkit -i <package>"
	if [ "$scan" = 1 ]; then
		names=
		for a in "$@"; do
			case $a in -*) ;; *) names="$names $a" ;; esac
		done
		# shellcheck disable=SC2086
		[ -n "$names" ] && scan_packages $names
	fi
	exec "$APK" add "$@"
}

cmd_scan() {
	engines=
	have_yara && engines="YARA"
	if have_av && have_db; then
		engines="${engines:+$engines, }ClamAV"
	fi
	if [ -z "$engines" ]; then
		warn "no scanning engine is usable right now:"
		have_yara || warn "  YARA: not installed or no rules (flowkit av install)"
		have_av && ! have_db && warn "  ClamAV: no databases (flowkit av status)"
		have_av || warn "  ClamAV: not installed (flowkit av install)"
		die "nothing to scan with. Try 'flowkit audit' (works offline)"
	fi

	if [ $# -gt 0 ]; then
		targets=" $1"
	else
		targets=
		for d in /bin /sbin /lib /usr /etc /root /home /opt /srv /var /tmp /boot; do
			[ -d "$d" ] && targets="$targets $d"
		done
	fi

	info "engines: $engines"
	hits=0

	if have_yara; then
		info "YARA: scanning$targets"
		# shellcheck disable=SC2086
		res=$(run_yara $targets)
		if [ -n "$res" ]; then
			printf '%s\n' "$res"
			hits=$((hits + $(printf '%s\n' "$res" | wc -l)))
		fi
	fi

	if have_av && have_db; then
		info "ClamAV: scanning$targets"
		# shellcheck disable=SC2086
		clamscan -r -i --no-summary \
			--exclude-dir='^/proc' --exclude-dir='^/sys' \
			--exclude-dir='^/dev' --exclude-dir='^/run' $targets
		[ $? -eq 1 ] && hits=$((hits + 1))
	fi

	if [ "$hits" -gt 0 ]; then
		warn "findings: $hits (YARA rules are indicators and can give false positives; check each file)"
		exit 1
	fi
	ok "no threats found (engines: $engines)"
}

cmd_audit() {
	need_root
	info "comparing installed files with their packages (apk audit)"
	tmp=$(mktemp /tmp/flowkit-audit.XXXXXX) || die "cannot create a temp file"
	"$APK" audit --system >"$tmp" 2>&1
	rc=$?
	added=$(grep -cE '^[Aa] ' "$tmp")
	changed=$(grep -vcE '^[Aa] ' "$tmp")
	if [ "$changed" -gt 0 ]; then
		warn "$changed entries differ from package contents (M modified, D deleted, m metadata, e error):"
		grep -vE '^[Aa] ' "$tmp" | head -n 50
		[ "$changed" -gt 50 ] && warn "... and $((changed - 50)) more"
	else
		ok "all package files match their packages"
	fi
	printf '    %s files are not owned by any package (own tools, caches, logs): not an alarm\n' "$added"
	rm -f "$tmp"
	[ "$changed" -gt 0 ] && exit 1
	[ "$rc" -gt 1 ] && warn "apk audit finished with code $rc"
	exit 0
}

cmd_av() {
	sub="${1:-status}"; [ $# -gt 0 ] && shift
	case "$sub" in
		install)
			need_root
			info "installing YARA and ClamAV"
			"$APK" add yara clamav freshclam || die "could not install the protection packages"
			ok "done. Next: flowkit av status"
			;;
		update)
			need_root
			verbose=0
			[ "${1:-}" = "--verbose" ] && verbose=1
			command -v freshclam >/dev/null 2>&1 || die "freshclam not found: flowkit av install"
			mem=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo 2>/dev/null)
			[ "${mem:-0}" -lt 1500 ] && warn "less than 1.5 GB RAM: ClamAV databases are large, memory may run out"
			# A wrong clock breaks TLS; frequent attempts get you rate-limited by the ClamAV CDN.
			[ "$(date +%Y)" -ge "$FK_MINYEAR" ] 2>/dev/null || \
				die "system clock looks wrong ($(date +%F)); fix it first: chronyd -q 'pool pool.ntp.org iburst'  (or: date -s 'YYYY-MM-DD HH:MM:SS')"
			mkdir -p "$CLAMDB"
			stamp="$CLAMDB/.flowkit-last-update"
			if [ -r "$stamp" ]; then
				age=$(( $(date +%s) - $(cat "$stamp" 2>/dev/null || echo 0) ))
				if [ "$age" -ge 0 ] && [ "$age" -lt 3600 ]; then
					die "last update was $((age / 60)) min ago; ClamAV allows at most one update per hour (try again in $(( (3600 - age + 59) / 60 )) min)"
				fi
			fi
			info "downloading ClamAV databases"
			log=$(mktemp /tmp/flowkit-fresh.XXXXXX) || die "cannot create a temp file"
			freshclam >"$log" 2>&1
			rc=$?
			date +%s > "$stamp"
			cp "$log" "$FRLOG" 2>/dev/null
			if grep -qE 'error code 403|Blocked by CDN|Forbidden' "$log"; then
				date +%F > "$BLOCKED"
				warn "the ClamAV server refused access (HTTP 403, 'Blocked by CDN')."
				warn "Possible reasons: a regional or network restriction on the provider's side. This is not a flowkit error."
				warn "ClamAV stays without fresh databases. Other layers still work: flowkit scan (YARA), flowkit audit."
				warn "Raw freshclam output: $FRLOG (the provider's cool-down is usually 24 h)"
				[ "$verbose" = 1 ] && cat "$log"
				rm -f "$log"
				exit 2
			fi
			cat "$log"
			rm -f "$log"
			[ "$rc" -eq 0 ] && rm -f "$BLOCKED"
			exit $rc
			;;
		status)
			printf '%sProtection layers%s\n' "$B" "$R"
			if command -v yara >/dev/null 2>&1; then
				n=0
				for f in $(yara_rules); do n=$((n + 1)); done
				if have_yara; then
					printf '  YARA      : %s, %s rule file(s)  (flowkit scan)\n' "$(yara --version 2>/dev/null | head -n 1)" "$n"
				else
					printf '  YARA      : installed, but no usable rules in %s\n' "$YARA_DIRS"
				fi
			else
				printf '  YARA      : not installed (flowkit av install)\n'
			fi
			if have_av; then
				if have_db; then
					printf '  ClamAV    : %s, databases: %s\n' "$(clamscan --version 2>/dev/null | head -n 1)" "$(ls "$CLAMDB" 2>/dev/null | grep -E '\.c[vl]d$' | tr '\n' ' ')"
				elif [ -e "$BLOCKED" ]; then
					printf '  ClamAV    : installed, NO databases: the server refused access on %s (details: /var/log/flowkit-av-update.log)\n' "$(cat "$BLOCKED" 2>/dev/null)"
				else
					printf '  ClamAV    : installed, no databases yet (flowkit av update)\n'
				fi
			else
				printf '  ClamAV    : not installed (flowkit av install)\n'
			fi
			printf '  Integrity : apk audit, works offline  (flowkit audit)\n'
			;;
		*) die "unknown command: av $sub (install, update, status)" ;;
	esac
}

cmd="${1:-}"
[ $# -gt 0 ] && shift

case "$cmd" in
	""|-h|--help|help) usage ;;
	-v|-V|--version|version) version ;;
	-i|install|add) cmd_install "$@" ;;
	-r|remove|del) need_root; exec "$APK" del "$@" ;;
	-s|search) exec "$APK" search -v "$@" ;;
	-l|list)
		case "${1:-}" in
			-a|--all) shift; exec "$APK" list "$@" ;;
			*) exec "$APK" list -I "$@" ;;
		esac
		;;
	scan) cmd_scan "$@" ;;
	audit) cmd_audit ;;
	av|antivirus) cmd_av "$@" ;;
	*) exec "$APK" "$cmd" "$@" ;;
esac
