#!/bin/sh
# ittyos-update - update a running ittyOS from its GitHub repository (run as root; needs curl or wget, no git)
#   ittyos-update        show the new version and ask before applying
#   ittyos-update -y     do not ask
#   ittyos-update -f     apply even when the version is the same (repair the system files)

REPO_URL="${ITTYOS_REPO:-https://github.com/IGBerko/ittyos}"
SRC="${ITTYOS_SRC:-/var/lib/ittyos/src}"
VFILE="${ITTYOS_VERSION_FILE:-/etc/ittyos-version}"
STATE_DIR="${ITTYOS_STATE_DIR:-/var/lib/ittyos}"
REPO_PATH="${REPO_URL#https://github.com/}"
RAW="${ITTYOS_RAW:-https://raw.githubusercontent.com/$REPO_PATH/main}"
API_SHA="${ITTYOS_API_SHA:-https://api.github.com/repos/$REPO_PATH/commits/main}"
TARBALL="${ITTYOS_TARBALL:-$REPO_URL/archive/refs/heads/main.tar.gz}"
YES=0
FORCE=0
for a in "$@"; do
	case "$a" in
		-y) YES=1 ;;
		-f) FORCE=1 ;;
		-h|--help) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
		*) echo "unknown option: $a (try -h)"; exit 1 ;;
	esac
done

if [ -t 1 ]; then
	R=$(printf '\033[0m'); B=$(printf '\033[1m'); CY=$(printf '\033[36m'); RD=$(printf '\033[31m')
else
	R=; B=; CY=; RD=
fi
info() { printf '%s==>%s %s\n' "$CY" "$R" "$*"; }
die()  { printf '%serror:%s %s\n' "$RD" "$R" "$*" >&2; exit 1; }

[ "$(id -u)" = 0 ] || die "root privileges required: sudo ittyos-update"
# downloads: curl, or wget; no git needed
if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
	info "installing curl"
	apk add curl >/dev/null 2>&1 || die "neither curl nor wget is available (flowkit -i curl)"
fi
http_get() { # url [header] -> stdout
	if command -v curl >/dev/null 2>&1; then
		curl -fsSL --retry 2 ${2:+-H "$2"} "$1" 2>/dev/null
	else
		wget -qO- ${2:+--header="$2"} "$1" 2>/dev/null
	fi
}
http_save() { # url file
	if command -v curl >/dev/null 2>&1; then
		curl -fL --retry 3 -# -o "$2" "$1"
	else
		wget -O "$2" "$1"
	fi
}

CURRENT=
[ -r "$VFILE" ] && CURRENT=$(tr -d '[:space:]' <"$VFILE")
[ -z "$CURRENT" ] && CURRENT=$(sed -n 's/^VERSION_ID=//p' /etc/os-release 2>/dev/null | tr -d '"[:space:]')

info "checking $REPO_URL"
NEW=$(http_get "$RAW/VERSION" | head -n1 | tr -d '[:space:]')
[ -n "$NEW" ] || die "cannot reach GitHub or the repository has no VERSION file"
case "$NEW" in *[!0-9A-Za-z._-]*) die "unexpected version string from the server" ;; esac
NEW_COMMIT=$(http_get "$API_SHA" "Accept: application/vnd.github.sha" | tr -d '[:space:]' | cut -c1-7)
case "$NEW_COMMIT" in *[!0-9a-f]*) NEW_COMMIT= ;; esac
OLD_COMMIT=$(cat "$STATE_DIR/applied-commit" 2>/dev/null | tr -d '[:space:]')

printf '  installed : %s\n  available : %s%s\n' "${CURRENT:-unknown}" "$NEW" "${NEW_COMMIT:+ (commit $NEW_COMMIT)}"

# no record of an earlier update, or another commit on the same version: offer to apply
if [ "$FORCE" = 0 ] && [ "$NEW" = "$CURRENT" ] && { [ -z "$NEW_COMMIT" ] || [ "$NEW_COMMIT" = "$OLD_COMMIT" ]; }; then
	info "already up to date"
	exit 0
fi

if [ "$YES" = 0 ]; then
	printf '\n%sThis downloads code from %s and runs it as root.%s\n' "$B" "$REPO_URL" "$R"
	printf 'Files shipped by ittyOS (motd, os-release, flowkit, configs, wallpapers) will be replaced;\nyour changes in them are lost. Packages and your own files are not touched.\n'
	printf 'Continue? [y/N] '
	read -r ans
	case "$ans" in y|Y|yes|YES) ;; *) echo "cancelled"; exit 1 ;; esac
fi

mkdir -p "$STATE_DIR" || die "cannot create $STATE_DIR"
TMP="$STATE_DIR/main.tar.gz"
info "downloading the sources"
http_save "$TARBALL" "$TMP" || { rm -f "$TMP"; die "download failed (no network, or GitHub is unreachable)"; }
rm -rf "$SRC"; mkdir -p "$SRC"
tar -xzf "$TMP" -C "$SRC" --strip-components=1 || { rm -f "$TMP"; die "the downloaded archive is damaged"; }
rm -f "$TMP"
[ -f "$SRC/build.sh" ] && [ -f "$SRC/VERSION" ] || die "the archive does not look like ittyOS sources"
sh "$SRC/build.sh" apply || die "applying the update failed"
[ -n "$NEW_COMMIT" ] && echo "$NEW_COMMIT" > "$STATE_DIR/applied-commit"
info "ittyOS is now $NEW. Log out and in (or reboot) to see everything."
